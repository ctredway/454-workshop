---
// The header's title: the 454 Workshop logo, then "docs".
import logo from '../assets/logo-workshop.svg';
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title">
  <img src={logo.src} width="86" height="35" alt="454 Workshop" />
  <span class="docs">docs</span>
</a>
<style>
  .site-title { display: flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--sl-color-white); font-weight: 700; font-size: var(--sl-text-h4); white-space: nowrap; }
  .site-title img { height: 2.5rem; width: auto; }
  .docs { color: var(--sl-color-gray-3); font-weight: 600; }
</style>
