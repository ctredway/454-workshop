{
  "name": "454-desktop",
  "productName": "454 Workshop",
  "version": "0.6.2-beta.41",
  "description": "454 Workshop",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "build:app": "node scripts/build-app.js",
    "start": "node scripts/build-app.js && electron .",
    "test": "vitest run",
    "dist": "node scripts/build-app.js && electron-builder --linux AppImage --win nsis",
    "test:e2e": "sh test/e2e.sh",
    "test:e2e:packaged": "sh test/e2e-packaged.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/allerta-stencil": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/racing-sans-one": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@fontsource/stardos-stencil": "^5.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "opentype.js": "^1.3.4",
    "sql.js": "^1.14.2",
    "three": "^0.128.0"
  },
  "build": {
    "appId": "com.ctredway.fourfivefour",
    "productName": "454 Workshop",
    "files": [
      "src/**",
      "app/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "ctredway",
      "repo": "454-workshop"
    },
    "npmRebuild": false,
    "artifactName": "454-Workshop-${version}-${os}-${arch}.${ext}"
  }
}
